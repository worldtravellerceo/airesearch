# GitHub personal access token (classic or fine-grained, public repo read scope).
# NOT the Actions GITHUB_TOKEN: that is capped at 1,000 req/hour per repository.
GH_PAT=

# Neon / Postgres connection string
DATABASE_URL=

# Anthropic API key — used only by the borderline-repo classifier
ANTHROPIC_API_KEY=

# Optional overrides
# AIRADAR_MIN_STARS=50
# AIRADAR_TIER1_SIZE=3000
# AIRADAR_FRESH_HALF_LIFE=180
