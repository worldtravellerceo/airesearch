# GitHub personal access token. NOT the Actions GITHUB_TOKEN: that one is capped
# at 1,000 requests/hour per repository, which is far too low for this workload.
GH_PAT=

# Optional. Without it, classification runs on the free rule engine alone.
ANTHROPIC_API_KEY=

# Optional overrides
# AIRADAR_DB=data/airadar.db
# AIRADAR_MIN_STARS=50
# AIRADAR_TRACK_LIMIT=6000
# AIRADAR_TIER1_SIZE=3000
# AIRADAR_RETAIN_DAYS=120
# AIRADAR_FRESH_HALF_LIFE=180
